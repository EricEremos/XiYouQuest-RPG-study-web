# Supabase — project URL and anon key from your Supabase dashboard.
# Auth is Better Auth (HKUST SSO); Supabase is the database + storage + edge
# functions only. The anon key is still used for RLS'd data access, now
# authorized by the Better Auth JWT (third-party auth).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Service role — server-side only (account deletion + achievement provisioning).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Better Auth (HKUST SSO) ------------------------------------------------
# App origin; also Better Auth's baseURL and sole trusted origin.
BETTER_AUTH_URL=http://localhost:3000
# Session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret
# Postgres connection string for Better Auth's own tables (better_auth schema).
# Use the Supabase SESSION pooler (port 5432) — transaction mode does not
# honor the search_path option Better Auth relies on.
BETTER_AUTH_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# --- HKUST OIDC (Microsoft Entra, staff tenant) -----------------------------
# App registration ce4cb5e3-... ; client secret issued by ITSO (expires
# 2028-06-28). providerId is "hkust"; callback is
# {BETTER_AUTH_URL}/api/auth/oauth2/callback/hkust (see docs/oidc-redirect-uris.md).
HKUST_XYQ_CLIENT_ID=your_hkust_client_id
HKUST_XYQ_CLIENT_SECRET=your_hkust_client_secret
HKUST_DISCOVERY_URL=https://login.microsoftonline.com/<tenant-guid>/v2.0/.well-known/openid-configuration

# --- AI + speech ------------------------------------------------------------
# OpenRouter — primary LLM (DeepSeek V4 Flash); Gemini is the fallback.
OPENROUTER_API_KEY=your_openrouter_api_key
GEMINI_API_KEY=your_gemini_api_key
# iFlytek — speech evaluation (ISE) and text-to-speech (TTS).
IFLYTEK_APP_ID=your_iflytek_app_id
IFLYTEK_API_KEY=your_iflytek_api_key
IFLYTEK_API_SECRET=your_iflytek_api_secret

# Supabase Edge Function secret (set via `supabase secrets set`, not in this app):
#   BETTER_AUTH_JWKS_URL=https://cle-xyq.hkust.edu.hk/api/auth/jwks
